<?xml version="1.0"?>
<JWM>
  <!-- No Tray, RootMenu, dock or visible desktop. -->
  <Group>
    <Class>BarviumMain</Class>
    <Option>noborder</Option>
    <Option>notitle</Option>
    <Option>maximized</Option>
  </Group>
  <Key mask="CA" key="t">exec:qterminal</Key>
  <Key mask="CA" key="T">exec:qterminal</Key>
  <!-- Brave starts only once on session startup: no watchdog. -->
  <StartupCommand>/usr/local/bin/barvium-session</StartupCommand>
</JWM>
