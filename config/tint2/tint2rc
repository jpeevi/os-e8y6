# Barvium top panel. See tint2(1) for configuration syntax.
panel_items = LE T S B C
panel_monitor = all
panel_position = top center horizontal
panel_size = 100% 36
panel_margin = 0 0
panel_padding = 7 3 6
panel_background_id = 0
panel_layer = top
panel_dock = 1
panel_shrink = 0
panel_window_name = BarviumPanel
strut_policy = follow_size
font_shadow = 0
rounded = 0
border_width = 0
background_color = #202630 100
border_color = #202630 100

# Launcher: JWM application menu is bound to Super+Space.
launcher_padding = 8 0 4
launcher_background_id = 0
launcher_icon_size = 21
launcher_item_app = /usr/share/applications/barvium-menu.desktop

# Network speed executor (two-second update; no telemetry).
execp = new
execp_command = /usr/local/bin/barvium-net-speed
execp_interval = 2
execp_has_icon = 0
execp_font = Sans 9
execp_font_color = #e3e7ef 100
execp_padding = 8 0 4
execp_centered = 1

# Applications other than Brave may appear in the taskbar.
taskbar_mode = multi_desktop
taskbar_padding = 2 0 3
taskbar_background_id = 0
task_icon = 1
task_text = 1
task_maximum_size = 180 30
task_padding = 5 3 4
task_font = Sans 9
task_font_color = #e3e7ef 100
task_background_id = 0

autohide = 0
systray_padding = 6 0 4
systray_icon_size = 19
systray_background_id = 0

battery = 1
battery_low_status = 10
battery_padding = 4 0
battery_font = Sans 9
battery_font_color = #e3e7ef 100
clock = 1
clock_format = %H:%M
clock_font = Sans 9
clock_font_color = #e3e7ef 100
clock_padding = 5 0
