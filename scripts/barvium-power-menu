#!/usr/bin/env bash
# Alt+F4 shows the Barvium system menu, without closing the active window.
set -u
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/barvium-power-menu.lock"
flock -n 9 || exit 0
command -v yad >/dev/null 2>&1 || { qterminal -e sh -c 'echo "Power menu unavailable: yad not installed"; read x'; exit 1; }
yad --center --fixed --on-top --skip-taskbar --title='Barvium Power' \
  --text='Choose a power action:' \
  --button='Cancel:0' --button='Log out:11' \
  --button='Restart:12' --button='Shut down:13' --width=340
status=$?
case "$status" in
  11) jwm -exit ;; # Ends X; see docs: live tty autologin may relaunch it.
  12) systemctl reboot ;;
  13) systemctl poweroff ;;
  *) exit 0 ;;
esac
