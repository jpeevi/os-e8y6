#!/usr/bin/env bash
set -u
sleep 3
while :; do
  ids="$(xdotool search --onlyvisible --classname 'BarviumMain' 2>/dev/null || true)"
  if [[ -z "$ids" ]]; then
    /usr/local/bin/barvium-open-brave >/dev/null 2>&1 || true
  else
    while read -r id; do
      [[ -n "$id" ]] || continue
      # Hides only the dedicated main browser window from Tint2's taskbar.
      wmctrl -i -r "$id" -b add,skip_taskbar >/dev/null 2>&1 || true
    done <<< "$ids"
  fi
  sleep 3
done
