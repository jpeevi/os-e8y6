-  exit 1
-fi
-printf 'WARNING: ALL selected virtual disks may be erased or modified.\n'
-printf 'Use disposable QEMU disks only. Type TEST-VM to continue: '
-read -r confirmation
-[[ "$confirmation" == TEST-VM ]] || { echo 'Cancelled.'; exit 1; }
-exec pkexec calamares
